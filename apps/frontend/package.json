{
  "name": "aquamux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts lib/server/dev-wallet/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint app components lib test e2e --max-warnings=0",
    "verify:fork": "tsx scripts/verify-fork.ts",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "format": "prettier --write app components lib test e2e scripts *.ts *.mjs *.json",
    "test:live": "tsx scripts/live-e2e.ts",
    "verify:live": "tsx scripts/verify-live-state.ts"
  },
  "dependencies": {
    "@1inch/aqua-sdk": "0.3.1",
    "@1inch/sdk-core": "0.1.3",
    "@1inch/swap-vm-sdk": "0.4.1",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "prettier": "3.8.1",
    "solc": "0.8.30",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
